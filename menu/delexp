#!/bin/bash
# ======================================================
# HOKAGE LEGEND - FULL AUTO DELEXP (BOT OPTIONAL)
# ======================================================
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'

# ==========================================
# 1. LOAD TELEGRAM BOT DATA (OPSIONAL)
# ==========================================
BOT_ACTIVE="false"
if [ -f /usr/bin/kyt/var.txt ]; then
    source /usr/bin/kyt/var.txt
    if [[ -n "$BOT_TOKEN" && -n "$ADMIN" ]]; then
        BOT_ACTIVE="true"
    fi
fi

# Fungsi Mengirim Pesan Telegram (Hanya jalan jika bot aktif)
send_telegram() {
    if [[ "$BOT_ACTIVE" == "true" ]]; then
        curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
            -d chat_id="${ADMIN}" \
            --data-urlencode text="$1" \
            -d parse_mode="html" > /dev/null 2>&1
    fi
}

# ==========================================
# 2. PERSIAPAN PATH & VARIABEL
# ==========================================
BACKUP_FILE="/etc/ssh_backup"
USAGE_DB="/etc/ssh/usage_db"
DB_FILE="/etc/ssh/.ssh.db"
ZIVPN_CONFIG="/etc/zivpn/config.json"
ZIVPN_DB="/etc/zivpn/user-db.json"
SERVICE_NAME="zivpn.service"

[[ ! -f "$BACKUP_FILE" ]] && touch "$BACKUP_FILE"
mkdir -p "$USAGE_DB"

todaystime=$(date +%s)
list_pesan_bot=""
count=0

echo -e "${CYAN}Memulai proses Auto-Cleanup Expired User...${NC}"

# ==========================================
# 3. PROSES PENGHAPUSAN SSH (SISTEM & DB)
# ==========================================
cat /etc/shadow | cut -d: -f1,8 | sed /:$/d > /tmp/expirelist.txt
while read -r tuserval; do
    username=$(echo $tuserval | cut -f1 -d:)
    userexp=$(echo $tuserval | cut -f2 -d:)
    
    [[ -z "$userexp" ]] && continue
    userexpireinseconds=$((userexp * 86400))
    
    if [ $userexpireinseconds -lt $todaystime ]; then
        echo -e "Memproses (Expired) : ${RED}$username${NC}"
        
        # BACKUP HASH
        pass_hash=$(grep -w "^$username" /etc/shadow | cut -d: -f2)
        [[ -n "$pass_hash" ]] && ! grep -q "^$username:" "$BACKUP_FILE" && echo "$username:$pass_hash" >> "$BACKUP_FILE"
        
        # DELETE SYSTEM
        userdel --force "$username" &> /dev/null
        rm -rf /home/"$username" &> /dev/null
        
        # DELETE DATABASE
        sed -i "/^#ssh# ${username}\b/d" "$DB_FILE" &> /dev/null
        rm -f "/var/www/html/ssh-$username.txt" &> /dev/null
        rm -f "/etc/kyt/limit/ssh/ip/$username" &> /dev/null
        rm -f "$USAGE_DB/$username.total" "$USAGE_DB/$username.last" &> /dev/null
        rm -f "/etc/cron.d/trialssh-$username" &> /dev/null
        
        list_pesan_bot+="- <code>$username</code> ✅\n"
        ((count++))
    fi
done < /tmp/expirelist.txt

# ==========================================
# 4. PROSES PENGHAPUSAN XRAY (VMESS/VLESS/TROJAN)
# ==========================================
if [ -f "/etc/xray/config.json" ]; then
    while read -r user_exp; do
        echo -e "Memproses Xray (Expired) : ${RED}$user_exp${NC}"
        sed -i "/^### $user_exp\b/d" "/etc/xray/config.json"
        sed -i "/^#& $user_exp\b/d" "/etc/xray/config.json"
        sed -i "/^#! $user_exp\b/d" "/etc/xray/config.json"
        list_pesan_bot+="- <code>$user_exp</code> (Xray) ✅\n"
        ((count++))
    done < <(grep -E "###|#&|#!" /etc/xray/config.json | cut -d ' ' -f 3 | while read d; do
        [[ $(date -d "$d" +%s 2>/dev/null) -lt $todaystime ]] && echo $(grep -w "$d" /etc/xray/config.json | cut -d ' ' -f 2)
    done | sort -u)
    
    # Restart Xray jika ada yang dihapus
    [[ $count -gt 0 ]] && systemctl restart xray > /dev/null 2>&1
fi

# ==========================================
# 5. PROSES PENGHAPUSAN ZIVPN
# ==========================================
if [ -f "$ZIVPN_CONFIG" ]; then
    [[ $count -gt 0 ]] && systemctl restart "$SERVICE_NAME" > /dev/null 2>&1
fi

# ==========================================
# 6. NOTIFIKASI TELEGRAM
# ==========================================
if [ $count -gt 0 ]; then
    echo -e "${GREEN}Berhasil menghapus $count user expired dari sistem.${NC}"
    send_telegram "✅ <b>AUTO-CLEANUP SELESAI</b> ✅\n\nTotal <b>$count</b> user (SSH/Xray) telah dihapus dari sistem & database.\n\n${list_pesan_bot}"
else
    echo -e "${GREEN}Sistem bersih. Tidak ada user yang expired hari ini.${NC}"
fi

rm -f /tmp/expirelist.txt