#!/bin/bash
RED='\e[1;31m'
GREEN='\e[1;32m'
YELLOW='\e[1;33m'
CYAN='\e[1;36m'
PURPLE='\e[1;35m'
NC='\e[0m'
BLINK_RED='\e[5;31m'

CONFIG_FILE="/etc/zivpn/config.json"
USER_DB="/etc/zivpn/user-db.json"
SSH_DB="/etc/ssh/.ssh.db"
ZIVPN_SERVICE="zivpn.service"
UDP_SERVICE="udp-custom.service"

if ! command -v jq &> /dev/null; then
    apt-get update && apt-get install jq -y >/dev/null 2>&1
fi

function header() {
    clear
    DOM=$(cat /etc/xray/domain 2>/dev/null || echo "IP-Only")
    MYIP=$(wget -qO- icanhazip.com)
    RAM=$(free -m | grep Mem | awk '{print $3"/"$2" MB"}')
    UPTIME=$(uptime -p | cut -d " " -f 2-10)
    
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}      ⚡ ZIVPN ULTIMATE MANAGER V6.8 ⚡          ${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${GREEN}🖥️  VPS IP    :${NC} $MYIP"
    echo -e "  ${GREEN}🌐  Domain    :${NC} $DOM"
    echo -e "  ${GREEN}💾  RAM Usage :${NC} $RAM"
    echo -e "  ${GREEN}⏳  Uptime    :${NC} $UPTIME"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

function monitor_users() {
    header
    echo -e "             📊  MONITOR USER (SISA HARI)              "
    echo -e "${CYAN}--------------------------------------------------${NC}"
    printf "${YELLOW}%-4s %-16s %-12s %-15s${NC}\n" "No" "Username" "Expired" "Status"
    
    n=1
    today_sec=$(date +%s)
    NEED_RESTART=0

    # --- LOOPING SEPERTI SCRIPT SSH (SOURCE: /etc/passwd) ---
    while IFS=: read -r username _ uid _ _ _ shell; do
        # Filter: Hanya User Biasa (UID >= 1000) dan bukan 'nobody'
        if [[ "$uid" -ge 1000 && "$username" != "nobody" && "$username" != "zi" ]]; then
            
            # 1. CEK EXPIRED (DARI SYSTEM CHAGE)
            exp_str=$(chage -l "$username" | grep "Account expires" | cut -d: -f2 | xargs)
            
            if [[ "$exp_str" == *"never"* || -z "$exp_str" ]]; then 
                exp_display="Unlimited"
                status_text="${GREEN}ACTIVE${NC}"
                # Format tanggal untuk DB (9999-12-31)
                exp_db="2099-12-31"
            else
                exp_sec=$(date -d "$exp_str" +%s 2>/dev/null)
                exp_db=$(date -d "$exp_str" +"%Y-%m-%d" 2>/dev/null)
                
                # Hitung selisih hari
                if [[ -n "$exp_sec" ]]; then
                    diff=$(( (exp_sec - today_sec) / 86400 ))
                    exp_display=$(date -d "$exp_str" +"%Y-%m-%d")
                    
                    if [ "$diff" -lt 0 ]; then
                        status_text="${RED}EXPIRED${NC}"
                    elif [ "$diff" -eq 0 ]; then
                        status_text="${BLINK_RED}HARI INI${NC}"
                    else
                        status_text="${GREEN}$diff Hari Lagi${NC}"
                    fi
                else
                    exp_display="Error"
                    status_text="${RED}Unknown${NC}"
                fi
            fi
            if ! jq -e ".auth.config | index(\"$username\")" "$CONFIG_FILE" > /dev/null; then
                 jq --arg u "$username" '.auth.config += [$u]' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
                 NEED_RESTART=1
            fi
            if [[ -n "$exp_db" ]]; then
                # Selalu update expiry date agar sinkron
                jq --arg u "$username" --arg e "$exp_db" '.[$u] = {exp: $e}' "$USER_DB" > "${USER_DB}.tmp" && mv "${USER_DB}.tmp" "$USER_DB"
            fi
            printf "%-4s %-16s %-12s %-15b\n" "$n" "${username:0:16}" "$exp_display" "$status_text"
            ((n++))
        fi
    done < /etc/passwd

    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    if [ "$NEED_RESTART" -eq 1 ]; then
        echo -e " ${YELLOW}[INFO] Mendeteksi user baru dari SSH. Merestart ZiVPN...${NC}"
        systemctl restart zivpn
        echo -e " ${GREEN}[OK] User berhasil disinkronkan.${NC}"
    fi

    read -n 1 -s -r -p "Tekan Enter untuk kembali..."
}
function fix_json() {
    header
    echo -e "    🚨 EMERGENCY FIX: RESET CONFIG ZIVPN 🚨"
    echo -e "${CYAN}--------------------------------------------------${NC}"
    echo -e "Fitur ini akan:"
    echo -e "1. Mereset config.json ke default (Port 5667)"
    echo -e "2. Memasukkan kembali SEMUA user SSH ke ZIVPN"
    echo -e "3. Restart Service"
    echo -e ""
    read -p "Yakin ingin melanjutkan? (y/n): " ans
    if [[ "$ans" != "y" ]]; then return; fi

    echo -e "\n${YELLOW}[1/3] Menghentikan service...${NC}"
    systemctl stop zivpn

    echo -e "${YELLOW}[2/3] Membuat ulang config default...${NC}"
    # Membuat Config Standar (Port 5667)
    cat > /etc/zivpn/config.json <<EOF
{
  "listen": ":5667",
   "cert": "/etc/zivpn/zivpn.crt",
   "key": "/etc/zivpn/zivpn.key",
   "obfs":"zivpn",
   "auth": {
    "mode": "passwords", 
    "config": ["zi"]
  }
}
EOF
    chmod 644 /etc/zivpn/config.json

    echo -e "${YELLOW}[3/3] Sinkronisasi User SSH...${NC}"
    # Loop user system dan masukkan ke json (Safe Mode)
    while IFS=: read -r username _ uid _ _ _ _; do
        if [[ $uid -ge 1000 && "$username" != "nobody" && "$username" != "zi" ]]; then
            # Cek apakah user sudah ada (untuk menghindari duplikat)
            if ! jq -e --arg u "$username" '.auth.config | index($u)' /etc/zivpn/config.json >/dev/null 2>&1; then
                jq --arg u "$username" '.auth.config += [$u]' /etc/zivpn/config.json > /etc/zivpn/config.json.tmp
                if [ -s "/etc/zivpn/config.json.tmp" ]; then
                    mv /etc/zivpn/config.json.tmp /etc/zivpn/config.json
                    echo -e "  > Restore User: ${GREEN}$username${NC}"
                fi
            fi
        fi
    done < /etc/passwd

    echo -e "${GREEN}Service Restarting...${NC}"
    systemctl restart zivpn
    sleep 2
    
    # Cek Status
    if systemctl is-active --quiet zivpn; then
        echo -e "\n${GREEN}✅ SUKSES! ZIVPN sudah normal kembali.${NC}"
    else
        echo -e "\n${RED}❌ GAGAL! Cek log dengan 'journalctl -u zivpn'${NC}"
    fi
    read -n 1 -s -r -p "Tekan Enter untuk kembali..."
}
function delete_user() {
    header
    read -p " Masukkan Username: " username
    [ -z "$username" ] && return
    jq --arg u "$username" '.auth.config -= [$u]' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
    jq --arg u "$username" 'del(.[$u])' "$USER_DB" > "${USER_DB}.tmp" && mv "${USER_DB}.tmp" "$USER_DB"
    sed -i "/#ssh# $username/I d" "$SSH_DB"
    userdel -f "$username" &>/dev/null  
    systemctl restart "$ZIVPN_SERVICE"
    echo -e "${GREEN} ✅ User $username berhasil dihapus total.${NC}"; sleep 2
}
function restart_menu() {
    header
    echo -e " [1] Restart ZiVPN\n [2] Restart UDP Custom\n [0] Kembali"
    read -p " Pilih: " rs
    case $rs in
        1) systemctl restart "$ZIVPN_SERVICE" ;;
        2) systemctl restart "$UDP_SERVICE" ;;
    esac
}
function auto_delete_expired() {
    header
    echo -e "      🗑️  AUTO DELETE EXPIRED USERS (SYSTEM SCAN) 🗑️"
    echo -e "${CYAN}--------------------------------------------------${NC}"
    
    today_sec=$(date +%s)
    deleted_count=0

    # Scan System User langsung (/etc/passwd)
    while IFS=: read -r username _ uid _ _ _ shell; do
        if [[ "$uid" -ge 1000 && "$username" != "nobody" && "$username" != "zi" ]]; then
            
            exp_str=$(chage -l "$username" | grep "Account expires" | cut -d: -f2 | xargs)
            
            if [[ "$exp_str" != *"never"* && -n "$exp_str" ]]; then
                exp_sec=$(date -d "$exp_str" +%s 2>/dev/null)
                
                # Jika Expired Time < Waktu Sekarang (Sudah lewat)
                if [[ "$exp_sec" -lt "$today_sec" ]]; then
                    echo -e " ${RED}➤ MENGHAPUS: $username (Expired: $exp_str)${NC}"
                    
                    # Hapus Total
                    jq --arg u "$username" '.auth.config -= [$u]' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
                    jq --arg u "$username" 'del(.[$u])' "$USER_DB" > "${USER_DB}.tmp" && mv "${USER_DB}.tmp" "$USER_DB"
                    sed -i "/#ssh# $username/I d" "$SSH_DB"
                    userdel -f "$username" &>/dev/null
                    
                    ((deleted_count++))
                fi
            fi
        fi
    done < /etc/passwd

    echo -e "${CYAN}--------------------------------------------------${NC}"
    if [ "$deleted_count" -gt 0 ]; then
        echo -e "${GREEN} ✅ Berhasil menghapus $deleted_count user.${NC}"
        systemctl restart "$ZIVPN_SERVICE"
    else
        echo -e "${GREEN} ✅ Tidak ada user expired.${NC}"
    fi
    read -n 1 -s -r -p "Tekan Enter untuk kembali..."
}
while true; do
    header
    echo -e " ${GREEN}[01]${NC} Monitor Sisa Hari (Akun)"
    echo -e " ${GREEN}[02]${NC} Hapus User (Manual)"
    echo -e " ${GREEN}[03]${NC} Restart Service"
    echo -e " ${RED}[04]${NC} HAPUS USER EXPIRED OTOMATIS"
	echo -e " ${YELLOW}[05]${NC} Fix Config ZIVPN (Rusak/Error)"
    echo -e " ${GREEN}[00]${NC} Keluar"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    read -p " Pilih: " opt
    case $opt in
        1|01) monitor_users ;;
        2|02) delete_user ;;
        3|03) restart_menu ;;
        4|04) auto_delete_expired ;;
		5|05) fix_json ;;
        0|00) exit 0 ;;
        *) echo "Pilihan salah" ; sleep 1 ;;
    esac
done